{"$schema": "../../config/schemas/ai.schema.json", "version": "1.0.0", "name": "AI Opponent System", "description": "AAA-quality AI opponent system with racing line optimization, combat AI, personality profiles, and difficulty scaling", "modules": {"core": {"path": "../core/AISystem.js", "class": "AISystem", "description": "Main AI controller that manages all AI opponents", "exports": ["AISystem", "AI_PERSONALITIES", "DIFFICULTY_PRESETS"]}, "pathfinder": {"path": "./ai.pathfinder.js", "description": "Racing line calculation, corner detection, overtaking zone identification", "exports": ["calculateRacingLine", "findOvertakingZones", "detectCorners", "classifyCorner", "getRacingLinePoint", "projectToRacingLine", "distanceXZ"]}, "combat": {"path": "./ai.combat.js", "description": "Combat AI for item usage, targeting, defense decisions", "exports": ["selectItem", "selectTarget", "shouldDefend", "shouldDodge", "coordinateWithTeam", "calculateLeadTarget"]}}, "personalities": {"aggressive": {"name": "Aggressor", "displayName": "The Aggressor", "riskTaking": 0.9, "combatFocus": 0.8, "overtakingAggression": 0.9, "mistakeChance": 0.15, "driftPreference": 0.7, "itemOffenseWeight": 0.9, "itemDefenseWeight": 0.3, "itemTrickWeight": 0.4, "itemBalanceWeight": 0.2, "itemRandomWeight": 0.1, "color": "#ff4444", "icon": "⚔️", "description": "Takes risks, attacks often, makes mistakes from aggressive moves", "playstyle": "High risk, high reward. Pushes limits on every corner."}, "defensive": {"name": "Defender", "displayName": "The Defender", "riskTaking": 0.2, "combatFocus": 0.3, "overtakingAggression": 0.3, "mistakeChance": 0.05, "driftPreference": 0.3, "itemOffenseWeight": 0.1, "itemDefenseWeight": 0.9, "itemTrickWeight": 0.2, "itemBalanceWeight": 0.5, "itemRandomWeight": 0.1, "color": "#4444ff", "icon": "🛡️", "description": "Clean racer, blocks often, consistent performance", "playstyle": "Steady and reliable. Hard to pass once in front."}, "balanced": {"name": "Balanced", "displayName": "The Balanced Racer", "riskTaking": 0.5, "combatFocus": 0.5, "overtakingAggression": 0.5, "mistakeChance": 0.1, "driftPreference": 0.5, "itemOffenseWeight": 0.4, "itemDefenseWeight": 0.4, "itemTrickWeight": 0.3, "itemBalanceWeight": 0.6, "itemRandomWeight": 0.15, "color": "#44ff44", "icon": "⚖️", "description": "Adapts to situation, no strong bias either way", "playstyle": "Adaptable racer who reads the race conditions well."}, "trickster": {"name": "Trickster", "displayName": "The Trickster", "riskTaking": 0.7, "combatFocus": 0.6, "overtakingAggression": 0.6, "mistakeChance": 0.12, "driftPreference": 0.95, "itemOffenseWeight": 0.5, "itemDefenseWeight": 0.3, "itemTrickWeight": 0.9, "itemBalanceWeight": 0.3, "itemRandomWeight": 0.2, "color": "#ff44ff", "icon": "🎭", "description": "Drift master, uses items creatively and unpredictably", "playstyle": "Unpredictable and flashy. Masters tight corners with style."}, "rookie": {"name": "Rookie", "displayName": "The Rookie", "riskTaking": 0.3, "combatFocus": 0.2, "overtakingAggression": 0.2, "mistakeChance": 0.25, "driftPreference": 0.2, "itemOffenseWeight": 0.2, "itemDefenseWeight": 0.4, "itemTrickWeight": 0.1, "itemBalanceWeight": 0.3, "itemRandomWeight": 0.6, "color": "#ffaa44", "icon": "🌱", "description": "Beginner AI that makes human-like mistakes", "playstyle": "Learning the ropes. Makes noticeable mistakes but improving."}}, "difficultyPresets": {"relaxed": {"name": "Relaxed", "displayName": "Relaxed", "reactionTime": 0.4, "mistakeMultiplier": 2.0, "speedOptimization": 0.85, "combatSkill": 0.5, "lookaheadReduction": 0.3, "steeringSmoothing": 0.03, "brakeEarlyFactor": 1.4, "driftSkill": 0.4, "color": "#88ff88", "description": "Casual racing experience, forgiving AI opponents"}, "normal": {"name": "Normal", "displayName": "Normal", "reactionTime": 0.25, "mistakeMultiplier": 1.0, "speedOptimization": 0.92, "combatSkill": 0.7, "lookaheadReduction": 0.5, "steeringSmoothing": 0.06, "brakeEarlyFactor": 1.15, "driftSk